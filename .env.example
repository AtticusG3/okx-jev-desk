# OKX + Jev Desk — engine environment.
# Copy to .env and fill. NEVER commit .env (it is gitignored).
#
# The engine refuses to boot if MODE and credentials disagree, so a clone of
# this repo boots offline with MODEL=mock and no keys at all.

# ---------- operating mode ----------
# mock   = synthetic book, mock brain, simulated fills
# demo   = OKX DEMO trading (x-simulated-trading: 1), real or mock brain
# paper  = live OKX public data, NO orders, simulated fills
# live   = live OKX with REAL ORDERS. Requires LIVE_CONFIRM=I_UNDERSTAND.
#
# Default is mock so that `cp .env.example .env && npm run engine` works on a
# fresh clone with no credentials. The engine REFUSES TO BOOT if the mode and
# the credentials disagree, so demo here without keys would be a hard error.
# Work up to demo only after adding demo keys below.
MODE=mock

# ---------- brain ----------
# mock = local heuristic (offline, free, deterministic)
# jev  = TypeSafe System One (needs TYPESAFE_API_KEY)
MODEL=mock
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# jev-latest is an ALIAS and moves when a new release ships. Pin jev-1.13.0 if
# you have tuned confidence thresholds — an alias move silently changes answers.
# The proof bar REQUIRES a pinned id: an alias means a 28-day era and the next
# era were collected under different models, which is not a comparison.
JEV_MODEL_ID=jev-latest
JEV_TIMEOUT_MS=1500

# Hard daily ceiling on Jev spend, in USD. Jev bills INPUT TOKENS ONLY
# ($0.042/MTok, output free), so this is enforced by summing the `calls` table
# over the current UTC day. When it is reached, every sleeve holds and opens
# nothing until 00:00 UTC — it is a gate, not a warning.
# Spend is read from the ledger, not from memory, so a restart inside the same
# day does not hand the desk a fresh budget.
# 0 disables the cap. Do not disable it on a fast tick: a capped desk looks
# identical to an uncapped one that happens to be quiet.
JEV_DAILY_USD_CAP=2

# Which transport reaches the brain. All three speak the same System One
# protocol (POST {model,state,questions} -> {answers,usage}), so only the URL
# and the credential change.
#   typesafe    POST https://api.typesafe.ai/v1/systemone    TYPESAFE_API_KEY
#   openrouter  POST https://openrouter.ai/api/v1/systemone OPENROUTER_API_KEY
#   local       POST $JEV_BASE_URL/v1/systemone             JEV_API_KEY (optional)
# NOTE: OpenRouter's System One route is /v1/systemone, NOT /chat/completions.
JEV_PROVIDER=typesafe
# Only for JEV_PROVIDER=local. No default on purpose - a self-hosted OpenJev
# shim has no address we could guess, and guessing one yields a desk that holds
# forever with nothing to explain it.
JEV_BASE_URL=
# Overrides the credential for ANY provider. Set deliberately only.
JEV_API_KEY=

# ---------- OKX credentials (Trade + Read only. No withdraw, ever) ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_REST_BASE=https://www.okx.com
# Leave blank to derive from REST_BASE + mode. Only set to override.
OKX_WS_PUBLIC=
OKX_WS_PRIVATE=

# ---------- universe ----------
OKX_INST_IDS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,DOGE-USDT-SWAP,XRP-USDT-SWAP
LEVERAGE=3

# ---------- loop ----------
# 10s is the sane default for a multi-sleeve desk. Faster than this and OKX +
# Jev latency make the decision stale before it lands, and cost rises with no
# gain. validate() warns below 1000.
TICK_MS=10000
MAX_JEV_CONCURRENCY=3

# ---------- sizing + risk (all hard gates, always on) ----------
QUOTE_USD=40
MAX_POS_USD=200
MAX_GROSS_USD=800
MAX_DAILY_LOSS_USD=80
MIN_DIR_PROB=0.55
MIN_DIR_CONF=0.45
MIN_ENTRY_QUALITY=2.0
MAX_ADDS_PER_SLEEVE=2
MAX_ORDERS_PER_MIN=20
MAX_SPREAD_BPS=25
MIN_NOTIONAL_USD=10

# ---------- execution ----------
# Keep entries post-only. false allows crossing orders, which is a taker fill.
ALWAYS_POST_ONLY=true
# Spec-recommended safe default: disable pyramiding for the first demo week.
ENABLE_ADD=false

# ---------- live money ----------
# Real orders need MODE=live AND LIVE_CONFIRM=I_UNDERSTAND AND keys; the engine
# refuses to boot otherwise, and `live` cannot be set over HTTP.
# A new live run is when the desk is least trustworthy, so it opens at a
# fraction of the configured size and is allowed to grow into it. The ramp
# scales the position TARGET, never the gates: a small position still has to
# pass every cap and stop. Only ever makes positions smaller — a multiplier
# above 1 is refused at boot.
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=24
# Ending a live run must work from a shell when the dashboard is the thing that
# is broken, and with no auth path that could be misconfigured open. Touch this
# file: the engine stops asking Jev, cancels, flattens, and latches until
# restart. POST /kill still works but needs the HTTP server.
CLOSE_LIVE_FILE=data/close-live

# ---------- server ----------
ENGINE_PORT=3000
# If set, mutating routes and /events require `Authorization: Bearer <token>`.
DASHBOARD_TOKEN=

# Self-check: how often the engine reclassifies its own ledger.
# Reads the whole ledger, so keep this minutes-to-hours, not seconds.
PROOF_INTERVAL_MS=900000
